# INSTITRACK Backend Environment Configuration
# Copy this file to .env and adjust values for your environment

# Application
APP_NAME=INSTITRACK
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (SQLite for local demo; change to PostgreSQL URL for production)
DATABASE_URL=sqlite:///./institack.db

# CORS - frontend origin
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx

# AI / Similarity
SIMILARITY_THRESHOLD=0.35

# Seed / Demo
SEED_DEMO_DATA=true
